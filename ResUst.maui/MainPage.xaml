<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ResUst.maui"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="ResUst.maui.MainPage"
             Title="Устойчивость системы &#x00AD;'деривация - уравнительный резервуар'">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Открыть" 
                     Clicked="Open_Click" 
                     IconImageSource="open_icon.png" />
        <ToolbarItem Text="Сохранить" 
                     Clicked="Save_Click" 
                     IconImageSource="save_icon.png" />
        <ToolbarItem Text="Выполнить" 
                     Clicked="Execute_Click" 
                     IconImageSource="execute_icon.png" />
        <ToolbarItem Text="Сохранить результат" 
                     Clicked="Save_Results_Click" 
                     IconImageSource="save_icon.png" 
                     x:Name="saveResults_button"/>
        <ToolbarItem Clicked="Help_Click" 
                     IconImageSource="help_icon.png" />
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <ResourceDictionary>
            
            <Style x:Key="EntryStyle"
                   TargetType="Entry">
                <Setter Property="WidthRequest" Value="80"/>
                <Setter Property="HeightRequest" Value="20"/>
                <Setter Property="Keyboard" Value="Numeric"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="VerticalOptions" Value="Center"/>

                <!-- Выделение текста при фокусе (Tab) -->
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <!-- Состояние по умолчанию -->
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
                                    <!-- Для ParamEntryStyle измените Light на #F0F0F2 -->
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#2C2C2C}" />
                                </VisualState.Setters>
                            </VisualState>

                            <!-- Состояние при фокусе (Tab / Клик) -->
                            <VisualState Name="Focused">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
                                    <!-- Для ParamEntryStyle измените Light на #F0F0F2 -->
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#333333}" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState Name="Invalid">
                                <VisualState.Setters>
                                    <!-- Красный текст и светло-красный фон для ошибки -->
                                    <Setter Property="TextColor" Value="Red" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEAEA, Dark=#4A2323}" />
                                </VisualState.Setters>
                            </VisualState>

                            <!-- Состояние, когда поле заблокировано (IsEnabled="False") -->
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=Gray, Dark=#888888}" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#1E1E1E}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>

            </Style>
            
            <Style x:Key="LabelStyle"
                   TargetType="Label">
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="VerticalOptions" Value="Center"/>
                <Setter Property="HorizontalOptions" Value="Start"/>
            </Style>

            <Style x:Key="TableLabelStyle" TargetType="Label">
                <!-- Автоматический цвет текста: черный для светлой темы, белый для темной -->
                <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <!-- Общий стиль для всех ячеек ввода в таблицах -->
            <Style x:Key="TableCellEntryStyle" TargetType="Entry">
                <Setter Property="WidthRequest" Value="80" />
                <Setter Property="Keyboard" Value="Numeric" />

                <!-- Привязка IsEnabled и IsVisible к свойствам родительской строки TableRow -->
                <Setter Property="IsEnabled" Value="{Binding Source={RelativeSource AncestorType={x:Type local:TableRow}}, Path=IsEditable}" />
                <Setter Property="IsVisible" Value="{Binding Source={RelativeSource AncestorType={x:Type local:TableRow}}, Path=IsVisible}" />

                <!-- Выделение текста при фокусе (Tab) -->
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <!-- Состояние по умолчанию -->
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#2C2C2C}" />
                                </VisualState.Setters>
                            </VisualState>

                            <!-- Состояние при фокусе (Tab / Клик) -->
                            <VisualState Name="Focused">
                                <VisualState.Setters>
                                    <!-- <Setter Property="CursorPosition" Value="0" />
                                    <Setter Property="SelectionLength" Value="100" /> -->
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#333333}" />
                                </VisualState.Setters>
                            </VisualState>

                            <VisualState Name="Invalid">
                                <VisualState.Setters>
                                    <!-- Красный текст и светло-красный фон для ошибки -->
                                    <Setter Property="TextColor" Value="Red" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEAEA, Dark=#4A2323}" />
                                </VisualState.Setters>
                            </VisualState>

                            <!-- Состояние, когда поле заблокировано (IsEnabled="False") -->
                            <VisualState Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=Gray, Dark=#888888}" />
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E0E0E0, Dark=#1E1E1E}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="GridTableLabelStyle" TargetType="Label">
                <!-- Автоматический цвет текста: черный для светлой темы, белый для темной -->
                <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=Black}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="GridTableStyle" TargetType="Grid">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=Black}" />
                <Setter Property="Padding" Value="5" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <HorizontalStackLayout Padding="15">
            <Grid ColumnDefinitions="240,*,*,*"
                  RowDefinitions="Auto,*,*,*,*,*,*,*,*,*,
                                  *,*,*,Auto">
                
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Text="Деривация"
                       Style="{StaticResource LabelStyle}"
                       FontAttributes="Bold"/>
                
                <Label Grid.Row="1"
                       Grid.Column="0"
                       Text="- длина Lд"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="1"
                       Grid.Column="1"
                       x:Name="ld"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>
                <Label Grid.Row="1"
                       Grid.Column="2"
                       Text="м"
                       Style="{StaticResource LabelStyle}"/>
                
                <Label Grid.Row="2"
                       Grid.Column="0"
                       Text="- площадь Fд"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="2"
                       Grid.Column="1"
                       x:Name="fd"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>
                <Label Grid.Row="2"
                       Grid.Column="2"
                       Text="м²"
                       Style="{StaticResource LabelStyle}"/>
                
                <Label Grid.Row="3"
                       Grid.Column="0"
                       Text="- коэффициент шероховатости n"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="3"
                       Grid.Column="1"
                       x:Name="nd"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>

                <Label Grid.Row="4"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Text="Резервуар"
                       Style="{StaticResource LabelStyle}"
                       FontAttributes="Bold"/>

                <Label Grid.Row="5"
                       Grid.Column="0"
                       Text="- коэффициент дополнительного сопротивления"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="5"
                       Grid.Column="1"
                       x:Name="dz"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>

                <Image Grid.Row="6"
                       Grid.Column="0"
                       Source="fkr.png"
                       WidthRequest="200"
                       HorizontalOptions="Center"
                       Aspect="AspectFit"/>
                <Label Grid.Row="6"
                       Grid.Column="1"
                       Text="= -"
                       x:Name="fkr"
                       Style="{StaticResource EntryStyle}"/>
                <Label Grid.Row="6"
                       Grid.Column="2"
                       Text="м²"
                       Style="{StaticResource LabelStyle}"/>

                <Label Grid.Row="7"
                       Grid.Column="0"
                       Text="- коэффициент Кр"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="7"
                       Grid.Column="1"
                       x:Name="kfr"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>

                <Label Grid.Row="8"
                       Grid.Column="0"
                       Text="- площадь Fр = Кр · Fкр"
                       Style="{StaticResource LabelStyle}"/>
                <Label Grid.Row="8"
                       Grid.Column="1"
                       Text="= -"
                       x:Name="fr"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"/>
                <Label Grid.Row="8"
                       Grid.Column="2"
                       Text="м²"
                       Style="{StaticResource LabelStyle}"/>

                <Label Grid.Row="9"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Text="Параметры расчета"
                       Style="{StaticResource LabelStyle}"
                       FontAttributes="Bold"/>

                <Label Grid.Row="10"
                       Grid.Column="0"
                       Text="- расход деривации Qд"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="10"
                       Grid.Column="1"
                       x:Name="qd"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>
                <Label Grid.Row="10"
                       Grid.Column="2"
                       Text="м³/с"
                       Style="{StaticResource LabelStyle}"/>

                <Label Grid.Row="11"
                       Grid.Column="0"
                       Text="- статический напор Hст"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="11"
                       Grid.Column="1"
                       x:Name="hct"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>
                <Label Grid.Row="11"
                       Grid.Column="2"
                       Text="м"
                       Style="{StaticResource LabelStyle}"/>

                <Label Grid.Row="12"
                       Grid.Column="0"
                       Text="- шаг расчета dt"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="12"
                       Grid.Column="1"
                       x:Name="dt"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>
                <Label Grid.Row="12"
                       Grid.Column="2"
                       Text="с"
                       Style="{StaticResource LabelStyle}"/>
                
                <Label Grid.Row="13"
                       Grid.Column="0"
                       Text="- время расчета T"
                       Style="{StaticResource LabelStyle}"/>
                <Entry Grid.Row="13"
                       Grid.Column="1"
                       x:Name="tr"
                       TextChanged="OnDoubleEntryTextChanged"
                       Focused="OnEntryFocused"
                       Style="{StaticResource EntryStyle}"/>
                <Label Grid.Row="13"
                       Grid.Column="2"
                       Text="с"
                       Style="{StaticResource LabelStyle}"/>

                


                <lvc:CartesianChart Grid.Row="0"
                                    Grid.Column="3"
                                    Grid.RowSpan="7"
                                    LegendPosition="Bottom"
                                    MinimumWidthRequest="700"
                                    LegendTextSize="12"
                                    TooltipTextSize="12"
                                    x:Name="HeadSeries">
                </lvc:CartesianChart>

                <lvc:CartesianChart Grid.Row="7"
                                    Grid.Column="3"
                                    Grid.RowSpan="7"
                                    LegendPosition="Bottom"
                                    MinimumWidthRequest="700"
                                    LegendTextSize="12"
                                    TooltipTextSize="12"
                                    x:Name="DischargeSeries">
                </lvc:CartesianChart>

            </Grid>
        </HorizontalStackLayout>
    </ScrollView>

</ContentPage>
